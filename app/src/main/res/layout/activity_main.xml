<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/remote_background"
    android:keepScreenOn="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/compact_title"
            android:textColor="@color/remote_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/control_off"
            android:textColor="@color/status_off"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/controller_panel"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/centerGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <com.example.mydemo260908.GearSelectorView
            android:id="@+id/leftGearButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:contentDescription="@string/left_gear_accessibility"
            app:layout_constraintEnd_toStartOf="@id/centerGuide"
            app:layout_constraintHorizontal_bias="0.14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:selectedColor="@color/action_a" />

        <TextView
            android:id="@+id/leftGearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/left_gear"
            android:textColor="@color/remote_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/leftGearButton"
            app:layout_constraintStart_toStartOf="@id/leftGearButton"
            app:layout_constraintTop_toBottomOf="@id/leftGearButton" />

        <com.example.mydemo260908.MasterSwitchView
            android:id="@+id/masterSwitch"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:contentDescription="@string/master_switch_off"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/masterSwitchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/master_switch"
            android:textColor="@color/remote_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/masterSwitch"
            app:layout_constraintStart_toStartOf="@id/masterSwitch"
            app:layout_constraintTop_toBottomOf="@id/masterSwitch" />

        <com.example.mydemo260908.GearSelectorView
            android:id="@+id/rightGearButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:contentDescription="@string/right_gear_accessibility"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.82"
            app:layout_constraintStart_toEndOf="@id/centerGuide"
            app:layout_constraintTop_toTopOf="parent"
            app:selectedColor="@color/action_c" />

        <TextView
            android:id="@+id/rightGearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/right_gear"
            android:textColor="@color/remote_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/rightGearButton"
            app:layout_constraintStart_toStartOf="@id/rightGearButton"
            app:layout_constraintTop_toBottomOf="@id/rightGearButton" />

        <TextView
            android:id="@+id/leftCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/default_coordinates"
            android:textColor="@color/remote_text_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/centerGuide"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/rightCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/default_coordinates"
            android:textColor="@color/remote_text_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/centerGuide" />

        <com.example.mydemo260908.JoystickView
            android:id="@+id/leftJoystick"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/left_joystick"
            app:layout_constraintBottom_toTopOf="@id/leftCoordinates"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@id/centerGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/leftGearLabel" />

        <com.example.mydemo260908.JoystickView
            android:id="@+id/rightJoystick"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/right_joystick"
            app:layout_constraintBottom_toTopOf="@id/rightCoordinates"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/centerGuide"
            app:layout_constraintTop_toBottomOf="@id/rightGearLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/outputText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/default_frame"
            android:textColor="@color/remote_text_secondary"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/output_rate"
            android:textColor="@color/joystick_knob"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
